---
import { AGENCIES, ALL_AGENCIES_VALUE } from "../scripts/agencies.js";
import { ORG_TYPES, orgColorMap } from "../scripts/graph_utils.js";

interface Props {
    show_controls?: boolean;
    width?: number;
    org_typ?: string[];
    weight_type?: "base" | "spending";
    spending?: "logged" | "unlogged";
    agency?: string;
    // CSS selector for an external "normalize y-axis" checkbox (see faceted_views.astro) that
    // this instance should follow. Left unset, the chart auto-scales its y-axis to the data.
    normalize_checkbox_selector?: string;
    // CSS selector for an external <select> whose option values are "base" | "spending_logged" |
    // "spending_unlogged" (see faceted_flow_graphs.astro's WEIGHT_ROWS) — a single control this
    // instance follows for both weight_type and spending at once. Takes precedence over the
    // weight_type/spending props below when set; left unset, those props (or show_controls's own
    // .af_weight_type/.af_log selects) are used instead.
    weight_selector?: string;
    // CSS selector for an external <select> of agency values (underscored AGENCIES.value, or
    // ALL_AGENCIES_VALUE) this instance should follow — mirrors weight_selector, for pages that
    // drive the chart from a shared agency control (see explorer_2.astro). Takes precedence over
    // the agency prop / show_controls's own .af_agency select; left unset, those are used.
    agency_selector?: string;
}
// Q - are astro props exactly like react props? are they a feature outside of vanilla js?

const { show_controls = true } = Astro.props;
const { width = 500} = Astro.props;
// These four are only used when show_controls is false — with controls shown, the
// <select>/checkbox elements are the source of truth and these props are ignored.
const {
    org_typ = ORG_TYPES.map((o) => o.value),
    weight_type = "base",
    spending = "unlogged",
    agency = ALL_AGENCIES_VALUE,
} = Astro.props;
const { normalize_checkbox_selector, weight_selector, agency_selector } = Astro.props;
---

<div
    class="annual-flow-chart"
    data-org-typ={JSON.stringify(org_typ)}
    data-weight-type={weight_type}
    data-spending={spending}
    data-agency={agency}
    data-normalize-selector={normalize_checkbox_selector}
    data-weight-selector={weight_selector}
    data-agency-selector={agency_selector}
>
{show_controls && (
        <div style={`width: ${width}px`}>
            <div class="params">
                <b>Agency: </b> &nbsp;
                <select class="af_agency">
                    {AGENCIES.map((a) => <option value={a.value}>{a.label}</option>)}
                    <option value={ALL_AGENCIES_VALUE}>All agencies</option>
                </select>
                &nbsp;&nbsp;
                <br>
                <b>Org type: </b> &nbsp;
                <span class="af_org_typ checkbox-group">
                    {ORG_TYPES.map((o) => (
                        <label class="checkbox-option">
                            <input type="checkbox" class="af_org_typ_input" value={o.value} checked />
                            <span class="swatch" style={`background:${orgColorMap[o.value as keyof typeof orgColorMap]}`}></span>
                            {o.label}
                        </label>
                    ))}
                </span>
                &nbsp;&nbsp;
                <b>Weight type: </b> &nbsp;
                <select class="af_weight_type">
                    <option value="base">base</option>
                    <option value="spending">spending</option>
                </select>
                &nbsp;&nbsp;
                <b>Spending: </b> &nbsp;
                <select class="af_log">
                    <option value="logged">log(spending)</option>
                    <option value="unlogged">plain spending</option>
                </select>
            </div>
        </div>
    )
}


<style>
    .checkbox-group {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25em 0.75em;
        vertical-align: middle;
    }
    .checkbox-option {
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
        white-space: nowrap;
        font-weight: normal;
    }
    .swatch {
        display: inline-block;
        width: 0.8em;
        height: 0.8em;
        border-radius: 2px;
    }
    .af_title {
        font-weight: 600;
        font-size: 0.9em;
        text-align: center;
        margin-bottom: 0.25em;
        /* Wrap onto multiple lines within the chart's own width instead of overflowing it —
           long agency names would otherwise force wider grid columns and make the facet grid
           uneven (see faceted_views.astro's "at once" layout). */
        overflow-wrap: anywhere;
    }
</style>

<div class="af_title"></div>
<div class="af_chart" data-width={width} style={`width:${width}px; max-width:100%;`}></div>
</div>

<script>
    import * as d3 from "d3";
    import { AGENCIES, ALL_AGENCIES_VALUE } from "../scripts/agencies.js";
    import { orgColorMap, orgTypeLabel, collapseOrgType } from "../scripts/graph_utils.js";

    // agency <select> values are the underscored AGENCIES.value strings, but flow_shares CSVs
    // key rows by the human-readable agency label (or "All agencies" for x_agy).
    const agencyLabels: Record<string, string> = Object.fromEntries(
        AGENCIES.map((a) => [a.value, a.label]),
    );
    agencyLabels[ALL_AGENCIES_VALUE] = "All agencies";

    interface FlowRow {
        agency: string;
        year: number;
        org_typ: string;
        flow_share: number;
    }

    // import.meta.env.BASE_URL includes the site's base path (see astro.config.mjs), so this
    // resolves correctly both in dev and once deployed under /lobbying_networks_site.
    // const FLOW_SHARES_DIR = `${import.meta.env.BASE_URL}data/flow_shares`;
    const FLOW_SHARES_DIR = 'https://pub-88f9b6b7dae846e9b9fe6489e8c253b0.r2.dev/flow_shares'

    // Decomposes a single WEIGHT_ROWS key (see faceted_flow_graphs.astro) into the weightType +
    // log pair redraw() needs, for instances following an external weight_selector.
    const WEIGHT_KEY_PARAMS: Record<string, { weightType: string; log: string }> = {
        base: { weightType: "base", log: "unlogged" },
        spending_logged: { weightType: "spending", log: "logged" },
        spending_unlogged: { weightType: "spending", log: "unlogged" },
    };

    function csvPathFor(weightType: string, log: string) {
        if (weightType === "base") return `${FLOW_SHARES_DIR}/base_weight_flow_shares.csv`;
        return log === "logged"
            ? `${FLOW_SHARES_DIR}/spending_weight_log_flow_shares.csv`
            : `${FLOW_SHARES_DIR}/spending_weight_nolog_flow_shares.csv`;
    }

    function buildTitle(agencyLabel: string, weightType: string, log: string, selectedTypes: string[]) {
        const weightLabel = weightType === "base"
            ? "base weight"
            : `spending weight (${log === "logged" ? "log" : "unlogged"})`;
        let title = `${agencyLabel} — ${weightLabel}`;
        if (selectedTypes.length === 1) title += ` — ${orgTypeLabel(selectedTypes[0])}`;
        return title;
    }

    // Parsed CSVs are cached by path so switching agency/org-type controls doesn't
    // re-fetch data that's already been loaded.
    const csvCache = new Map<string, Promise<FlowRow[]>>();
    function loadCsv(path: string): Promise<FlowRow[]> {
        let entry = csvCache.get(path);
        if (!entry) {
            entry = d3.csv(path, (d) => ({
                agency: d.agency as string,
                year: +(d.year as string),
                org_typ: collapseOrgType(d.org_typ as string),
                flow_share: +(d.flow_share as string),
            }));
            csvCache.set(path, entry);
        }
        return entry;
    }

    // Astro dedupes identical <script> blocks per page, so this runs once total even when
    // <AnnualFlowChart> is used more than once. Each instance is set up independently here,
    // scoped to its own root element, rather than relying on document-wide ids.
    // Below this rendered width (px), x-axis year labels are rotated diagonally so they
    // don't overlap — narrow facet grid cells and "individually" mini charts hit this often.
    const ROTATE_LABELS_BELOW = 500;

    function setupInstance(root: HTMLElement) {
        const container = root.querySelector<HTMLElement>(".af_chart");
        if (!container) throw new Error(".af_chart container not found");
        const titleEl = root.querySelector<HTMLElement>(".af_title");

        const width = Number(container.dataset.width) || 400;
        const height = Math.round(width * 0.65);
        const margin = { top: 16, right: 16, bottom: 32, left: 44 };

        const agencySelect = root.querySelector<HTMLSelectElement>(".af_agency");
        const weightTypeSelect = root.querySelector<HTMLSelectElement>(".af_weight_type");
        const logSelect = root.querySelector<HTMLSelectElement>(".af_log");
        const orgTypeCheckboxes = Array.from(
            root.querySelectorAll<HTMLInputElement>(".af_org_typ_input"),
        );

        // Used only when the corresponding control isn't rendered (show_controls=false);
        // when controls exist, their live values always take precedence over these.
        const fixedOrgTypes = JSON.parse(root.dataset.orgTyp || "[]") as string[];
        const fixedWeightType = root.dataset.weightType;
        const fixedSpending = root.dataset.spending;
        const fixedAgency = root.dataset.agency;

        // An external "normalize y-axis" checkbox (shared across many chart instances in the
        // "individually" facet view — see faceted_views.astro) that this instance follows, if any.
        const normalizeSelector = root.dataset.normalizeSelector;
        const normalizeCheckbox = normalizeSelector
            ? document.querySelector<HTMLInputElement>(normalizeSelector)
            : null;

        // An external combined weight-style <select> (see faceted_flow_graphs.astro's
        // WEIGHT_ROWS / annualflow_charts.astro's weight_selector prop) that, if present, takes
        // precedence over both weightTypeSelect/logSelect and fixedWeightType/fixedSpending.
        const weightSelectorAttr = root.dataset.weightSelector;
        const externalWeightSelect = weightSelectorAttr
            ? document.querySelector<HTMLSelectElement>(weightSelectorAttr)
            : null;

        // An external agency <select> (see annualflow_charts.astro's agency_selector prop /
        // explorer_2.astro's shared #agency control) that, if present, takes precedence over
        // both agencySelect and fixedAgency.
        const agencySelectorAttr = root.dataset.agencySelector;
        const externalAgencySelect = agencySelectorAttr
            ? document.querySelector<HTMLSelectElement>(agencySelectorAttr)
            : null;

        const svg = d3.select(container).append("svg")
            .attr("viewBox", [0, 0, width, height])
            .style("width", "100%")
            .style("height", "auto");

        // Grid groups are appended first so the year/share gridlines sit behind the axes,
        // data lines and year markers. They reuse the axis tick positions (see redraw).
        const GRID_STROKE = "#e6e6e6";
        const xGridG = svg.append("g")
            .attr("transform", `translate(0,${height - margin.bottom})`)
            .attr("stroke", GRID_STROKE)
            .attr("shape-rendering", "crispEdges");
        const yGridG = svg.append("g")
            .attr("transform", `translate(${margin.left},0)`)
            .attr("stroke", GRID_STROKE)
            .attr("shape-rendering", "crispEdges");

        const xAxisG = svg.append("g").attr("transform", `translate(0,${height - margin.bottom})`);
        const yAxisG = svg.append("g").attr("transform", `translate(${margin.left},0)`);
        const linesG = svg.append("g").attr("fill", "none").attr("stroke-width", 2);
        // Per-year markers on top of the lines; each shows its flow share on hover.
        const markersG = svg.append("g");

        // Matches the network explorer's tooltip (see nwk_explorer.js) for a consistent look:
        // white card, thin grey border, serif type, positioned off the page-level cursor.
        const tooltip = d3.select("body").append("div")
            .attr("class", "af-tooltip")
            .style("position", "absolute")
            .style("pointer-events", "none")
            .style("background", "white")
            .style("color", "#111")
            .style("border", "1px solid #ccc")
            .style("border-radius", "4px")
            .style("padding", "4px 8px")
            .style("font-family", "'Times New Roman', Times, serif")
            .style("font-size", "12px")
            .style("box-shadow", "0 1px 4px rgba(0,0,0,0.2)")
            .style("z-index", 1000)
            .style("opacity", 0);

        const line = d3.line<{ year: number; value: number }>()
            .x((d) => x(d.year))
            .y((d) => y(d.value));

        const x = d3.scaleLinear().range([margin.left, width - margin.right]);
        const y = d3.scaleLinear().range([height - margin.bottom, margin.top]);

        // Rotates the x-axis year labels diagonally once the chart renders narrow enough that
        // horizontal labels would overlap (small facet-grid cells, "individually" mini charts).
        function applyLabelRotation(renderedWidth: number) {
            const rotate = renderedWidth > 0 && renderedWidth < ROTATE_LABELS_BELOW;
            xAxisG.selectAll<SVGTextElement, unknown>("text")
                .style("text-anchor", rotate ? "end" : "middle")
                .attr("transform", rotate ? "rotate(-60)" : null)
                .attr("dx", rotate ? "-0.5em" : null)
                .attr("dy", rotate ? "0.15em" : null);
        }

        async function redraw() {
            const externalWeight = externalWeightSelect
                ? WEIGHT_KEY_PARAMS[externalWeightSelect.value]
                : undefined;
            const weightType = externalWeight?.weightType ?? weightTypeSelect?.value ?? fixedWeightType ?? "base";
            const log = externalWeight?.log ?? logSelect?.value ?? fixedSpending ?? "unlogged";
            const agency = externalAgencySelect?.value ?? agencySelect?.value ?? fixedAgency ?? ALL_AGENCIES_VALUE;
            const agencyLabel = agencyLabels[agency] ?? agency;
            const selectedTypes = orgTypeCheckboxes.length
                ? orgTypeCheckboxes.filter((c) => c.checked).map((c) => c.value)
                : fixedOrgTypes;

            const rows = await loadCsv(csvPathFor(weightType, log));
            const forAgency = rows.filter((r) => r.agency === agencyLabel);

            const years = d3.extent(forAgency, (r) => r.year) as [number, number];
            const yearRange = Number.isFinite(years[0])
                ? d3.range(years[0], years[1] + 1)
                : [];

            const series = selectedTypes.map((org_typ) => {
                const byYear = d3.rollup(
                    forAgency.filter((r) => r.org_typ === org_typ),
                    (v) => d3.sum(v, (r) => r.flow_share),
                    (r) => r.year,
                );
                return {
                    org_typ,
                    values: yearRange.map((yr) => ({ year: yr, value: byYear.get(yr) ?? 0 })),
                };
            });

            x.domain(years[0] !== undefined && Number.isFinite(years[0]) ? years : [2006, 2021]);

            const normalize = normalizeCheckbox?.checked ?? false;
            if (normalize) {
                y.domain([0, 1]);
            } else {
                y.domain([0, d3.max(series.flatMap((s) => s.values.map((v) => v.value))) || 1]).nice();
            }

            const xTicks = Math.min(yearRange.length, 10);
            xAxisG.call(d3.axisBottom(x).ticks(xTicks).tickFormat(d3.format("d")));
            applyLabelRotation(container!.getBoundingClientRect().width);
            // A fixed 0-100% domain lands on round ticks (0%, 20%, ...), so no extra precision is
            // needed there; an auto-scaled domain can otherwise round small shares down to "0%".
            yAxisG.call(d3.axisLeft(y).ticks(6).tickFormat(d3.format(normalize ? ".0%" : ".1%")));

            // Gridlines: same tick positions as the axes above, drawn full width/height with no
            // labels. Rebuilt each redraw so they track the current year range and y-domain.
            const innerH = height - margin.top - margin.bottom;
            const innerW = width - margin.left - margin.right;
            xGridG.call(d3.axisBottom(x).ticks(xTicks).tickSize(-innerH).tickFormat(() => ""));
            yGridG.call(d3.axisLeft(y).ticks(6).tickSize(-innerW).tickFormat(() => ""));
            xGridG.select(".domain").remove();
            yGridG.select(".domain").remove();

            if (titleEl) titleEl.textContent = buildTitle(agencyLabel, weightType, log, selectedTypes);

            linesG.selectAll<SVGPathElement, typeof series[number]>("path")
                .data(series, (d) => d.org_typ)
                .join("path")
                .attr("stroke", (d) => orgColorMap[d.org_typ as keyof typeof orgColorMap] ?? "#cccccc")
                .attr("d", (d) => line(d.values));

            // One marker per (org type, year) point; hovering reports that year's flow share.
            const markerFmt = d3.format(normalize ? ".1%" : ".2%");
            const markerData = series.flatMap((s) =>
                s.values.map((v) => ({ org_typ: s.org_typ, year: v.year, value: v.value })),
            );
            markersG.selectAll<SVGCircleElement, typeof markerData[number]>("circle")
                .data(markerData, (d) => `${d.org_typ}:${d.year}`)
                .join("circle")
                .attr("r", 3)
                .attr("cx", (d) => x(d.year))
                .attr("cy", (d) => y(d.value))
                .attr("fill", (d) => orgColorMap[d.org_typ as keyof typeof orgColorMap] ?? "#cccccc")
                .attr("stroke", "#fff")
                .attr("stroke-width", 1)
                .style("cursor", "pointer")
                .on("mouseenter", function (_event, d) {
                    d3.select(this).attr("r", 5);
                    tooltip.style("opacity", 1).html(
                        `<b>${orgTypeLabel(d.org_typ)}</b><br>${d.year}: ${markerFmt(d.value)}`,
                    );
                })
                .on("mousemove", (event) => {
                    tooltip
                        .style("left", `${event.pageX + 12}px`)
                        .style("top", `${event.pageY - 20}px`);
                })
                .on("mouseleave", function () {
                    d3.select(this).attr("r", 3);
                    tooltip.style("opacity", 0);
                });
        }

        [agencySelect, weightTypeSelect, logSelect].forEach((el) => {
            el?.addEventListener("change", redraw);
        });
        orgTypeCheckboxes.forEach((c) => c.addEventListener("change", redraw));
        normalizeCheckbox?.addEventListener("change", redraw);
        externalWeightSelect?.addEventListener("change", redraw);
        externalAgencySelect?.addEventListener("change", redraw);

        // Grid facet cells and the shared normalize checkbox can change this chart's rendered
        // width without firing any of the listeners above, so watch it directly.
        new ResizeObserver((entries) => {
            applyLabelRotation(entries[0].contentRect.width);
        }).observe(container);

        redraw();
    }

    document
        .querySelectorAll<HTMLElement>(".annual-flow-chart")
        .forEach((root) => setupInstance(root));
</script>


