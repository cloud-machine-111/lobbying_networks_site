---
import { colors } from "../styles/colors";
import Layout from "../layouts/Layout.astro";
import Nwk from "../components/nwk.astro";
import ColorLegend from "../components/color_legend.astro";
import { AGENCIES, ALL_AGENCIES_VALUE } from "../scripts/agencies.js";

// Wires up the facet controls and the props/selectors nwk.astro's `Nwk` reads. Contract
// (mirrors explorer.astro's inputs, plus AnnualFlowChart's `*_selector` idiom for controls
// shared across several chart instances — see annualflow_charts.astro's
// `normalize_checkbox_selector`):
//
//   agency?: string                 weight_type?: "base" | "spending"
//   log?: "logged" | "unlogged"     time_frame?: "annual" | "aggregate"
//   year?: number                   node_count?: number
//   width?: number                  show_controls?: boolean
//   agency_selector?: string        weight_selector?: string
//   time_frame_selector?: string    year_selector?: string
//
// A `*_selector` prop points at an external control (rendered below, outside the <Nwk>
// instance) that the component reads on mount and re-reads on "change"; a plain prop of the
// same name is the fixed value used when no selector is given. This lets several <Nwk>
// instances share one set of controls instead of each needing its own.
//
// `weight_selector` points at a <select> whose option values are WEIGHT_ROWS keys ("base" |
// "spending_logged" | "spending_unlogged") — Nwk decomposes that single value into weight_type +
// log itself, the same way WEIGHT_ROWS below decomposes it for the fixed-prop case.
//
// The first facet panel below (temporal) shows change over time as small multiples — one <Nwk>
// per year, each with a fixed `year` prop — rather than a single instance that tries to depict a
// [start, end] range on its own; Nwk only ever renders one year at a time.

const ALL_AGENCY_ROWS = [
    ...AGENCIES.map((a) => ({ key: a.value, label: a.label, agency: a.value })),
    { key: ALL_AGENCIES_VALUE, label: "All agencies", agency: ALL_AGENCIES_VALUE },
];

const WEIGHT_ROWS = [
    { key: "base", label: "base", weight_type: "base" as const, log: "unlogged" as const },
    { key: "spending_logged", label: "spending (log)", weight_type: "spending" as const, log: "logged" as const },
    { key: "spending_unlogged", label: "spending (unlogged)", weight_type: "spending" as const, log: "unlogged" as const },
];

// "nodes shown" is deliberately excluded from every control on this page (see the comments
// this file started with) — every faceted <Nwk> below is pinned to the same node count so the
// facets stay comparable, matching topNodesByFlow's default in nwk_view.astro.
const DEFAULT_NODES_SHOWN = 10;

// 1.2x the "base" mini/grid chart sizes used elsewhere on the site (e.g. faceted_flow_graphs.astro).
const MINI_WIDTH = 180 * 1.5;
const GRID_WIDTH = 320 * 1.5;

// Dataset only covers these years; the third facet's "single snapshot" controls default to a
// year in the middle of the range rather than either edge.
const YEAR_MIN = 2006;
const YEAR_MAX = 2021;
const DEFAULT_YEAR = 2011;

// Default [start, end] for the first facet's Start/End year inputs — narrower than the full
// dataset range so that panel doesn't dump all 22 year-columns on the page before the user has
// picked a range.
const DEFAULT_TF_START_YEAR = 2015;
const DEFAULT_TF_END_YEAR = 2020;

// One <Nwk> per year in the full dataset range, so the temporal facet's Start/End year inputs
// can just show/hide columns (see updateVisibleYears() below) rather than needing a way to
// re-parameterize an already-rendered Nwk instance — every year is guaranteed to have a column,
// so no [start, end] range can ever land on zero visible networks.
const SNAPSHOT_YEARS = Array.from({ length: YEAR_MAX - YEAR_MIN + 1 }, (_, i) => YEAR_MIN + i);
---

<Layout>
<style is:global define:vars={colors}>
    
    /* h3 used for graph titles. */
    .nwk_wrapper {
        border: solid 1px var(--lightBrown)
    }

    h3 {
        text-align: center;
    }
    /* Each facet-panel is a <details> so its section can be collapsed; only the first is open
       by default (see the open attribute below). */
    .facet-panel {
        border-bottom: solid 1px var(--lightBrown);
        margin-bottom: 1.5em;
        padding-bottom: 1em;
    }
    .facet-panel > summary {
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4em;
    }
    .facet-panel > summary::-webkit-details-marker {
        display: none;
    }
    .facet-panel > summary::before {
        content: "▸";
        display: inline-block;
        color: var(--lightBrown);
        transition: transform 0.15s ease;
    }
    .facet-panel[open] > summary::before {
        transform: rotate(90deg);
    }
    .facet-panel > summary h3 {
        margin: 0.6em 0;
    }
    .facet-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5em 1em;
    }
    .facet-cell {
        min-width: 0;
    }
    .facet-row-label {
        font-size: 0.8em;
        font-style: italic;
        text-align: center;
        color: var(--lightBrown);
        opacity: 0.8;
    }
    /* Temporal facet: one small chart per year, wrapped across as many lines as needed —
       mirrors faceted_flow_graphs.astro's "individually" org-type layout. */
    .facet-row-charts {
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
        flex: 1 1 auto;
        min-width: 0;
    }
    .facet-mini {
        flex: 0 0 auto;
    }
    .facet-mini.hidden {
        display: none;
    }
</style>


      <div style="font-style: italic; margin: 2em 0em; color: var(--lightBrown)">
   Short interpretation here.
</div>


<details class="facet-panel" open>
    <summary><h3> How do networks change temporally? </h3></summary>
    <p>note: diffs would be really good here. (ie "minus these nodes", "add/minus flow from these nodes")</p>
    <ColorLegend />
    <div class="params tf_params">
        <b>Agency: </b> &nbsp;
        <select class="tf_agency">
            {AGENCIES.map((a) => <option value={a.value}>{a.label}</option>)}
            <option value={ALL_AGENCIES_VALUE}>All agencies</option>
        </select>
        &nbsp;&nbsp;

        <b>Weight style: </b> &nbsp;
        <select class="tf_weight">
            {WEIGHT_ROWS.map((row) => <option value={row.key}>{row.label}</option>)}
        </select>
        &nbsp;&nbsp;

        <b>Start year: </b> &nbsp;
        <input type="number" class="tf_start_yr year-input" min={YEAR_MIN} max={YEAR_MAX} value={DEFAULT_TF_START_YEAR} />
        &nbsp;&nbsp;
        <b>End year: </b> &nbsp;
        <input type="number" class="tf_end_yr year-input" min={YEAR_MIN} max={YEAR_MAX} value={DEFAULT_TF_END_YEAR} />
    </div>

    <div class="facet-row-charts">
        {SNAPSHOT_YEARS.map((yr) => (
            <div class="facet-mini" data-year={yr} style={`width:${MINI_WIDTH}px`}>
                <div class="facet-row-label">{yr}</div>
                
                <div class="nwk_wrapper">
                <Nwk
                    agency_selector=".tf_agency"
                    weight_selector=".tf_weight"
                    time_frame="annual"
                    year={yr}
                    node_count={DEFAULT_NODES_SHOWN}
                    width={MINI_WIDTH}
                    show_controls={false}
                    show_title={false}
                    display_color_code="hide"
                />
                </div>

            </div>
        ))}
    </div>
</details>

<script>

    // One year per column, every one pre-rendered (see SNAPSHOT_YEARS) — Start/End year just
    // show/hide columns outside [start, end], so any valid start <= end always leaves at least
    // one column visible. Agency and weight style are read live by each Nwk instance via
    // agency_selector/weight_selector, so no per-instance toggling is needed for those.
    function setupTemporalToggles(root: ParentNode) {
        const startInput = root.querySelector<HTMLInputElement>(".tf_start_yr");
        const endInput = root.querySelector<HTMLInputElement>(".tf_end_yr");
        const minis = Array.from(root.querySelectorAll<HTMLElement>(".facet-row-charts .facet-mini"));
        if (!startInput || !endInput || !minis.length) return;

        function updateVisibleYears() {
            const start = Number(startInput!.value);
            const end = Number(endInput!.value);
            for (const mini of minis) {
                const year = Number(mini.dataset.year);
                mini.classList.toggle("hidden", !(year >= start && year <= end));
            }
        }

        startInput.addEventListener("change", updateVisibleYears);
        endInput.addEventListener("change", updateVisibleYears);
        updateVisibleYears();
    }

    // Scoped to the enclosing .facet-panel rather than .tf_params's parent: this component gets
    // embedded inside other pages' own wrapper elements, so anything looser than "this section's
    // own panel" risks also matching (and hiding) the other facet panels' grid cells below.
    document.querySelectorAll<HTMLElement>(".tf_params").forEach((paramsEl) => {
        const panel = paramsEl.closest<HTMLElement>(".facet-panel");
        if (panel) setupTemporalToggles(panel);
    });
</script>

<details class="facet-panel">
    <summary><h3> How does the same network vary across weight types? </h3></summary>
    <ColorLegend />
    <div class="params wt_params">
        <b>Agency: </b> &nbsp;
        <select class="wt_agency">
            {AGENCIES.map((a) => <option value={a.value}>{a.label}</option>)}
            <option value={ALL_AGENCIES_VALUE}>All agencies</option>
        </select>
        &nbsp;&nbsp;

        <b>Time frame: </b> &nbsp;
        <select class="wt_time_frame">
            <option value="annual">annual</option>
            <option value="aggregate">aggregate</option>
        </select>
        &nbsp;&nbsp;

        <span class="wt_year_group">
            <b>Year: </b> &nbsp;
            <input type="number" class="wt_year year-input" min={YEAR_MIN} max={YEAR_MAX} value={DEFAULT_YEAR} />
        </span>
    </div>

    <div class="facet-grid">
        {WEIGHT_ROWS.map((row) => (
            <div class="facet-cell">
                <div class="facet-row-label">{row.label}</div>
                <Nwk
                    weight_type={row.weight_type}
                    log={row.log}
                    agency_selector=".wt_agency"
                    time_frame_selector=".wt_time_frame"
                    year_selector=".wt_year"
                    node_count={DEFAULT_NODES_SHOWN}
                    width={GRID_WIDTH}
                    show_controls={false}
                    show_title={false}
                    display_color_code="hide"
                />
            </div>
        ))}
    </div>
</details>

<details class="facet-panel">
    <summary><h3> In a single snapshot of time, how do networks vary across agencies? </h3></summary>
    <ColorLegend />
    <div class="params ag_params">
        <b>Weight style: </b> &nbsp;
        <select class="ag_weight">
            {WEIGHT_ROWS.map((row) => <option value={row.key}>{row.label}</option>)}
        </select>
        &nbsp;&nbsp;

        <b>Time frame: </b> &nbsp;
        <select class="ag_time_frame">
            <option value="annual">annual</option>
            <option value="aggregate">aggregate</option>
        </select>
        &nbsp;&nbsp;

        <span class="ag_year_group">
            <b>Year: </b> &nbsp;
            <input type="number" class="ag_year year-input" min={YEAR_MIN} max={YEAR_MAX} value={DEFAULT_YEAR} />
        </span>
    </div>

    <div class="facet-grid">
        {ALL_AGENCY_ROWS.map((row) => (
            <div class="facet-cell">
                <div class="facet-row-label">{row.label}</div>
                <Nwk
                    agency={row.agency}
                    weight_selector=".ag_weight"
                    time_frame_selector=".ag_time_frame"
                    year_selector=".ag_year"
                    node_count={DEFAULT_NODES_SHOWN}
                    width={GRID_WIDTH}
                    show_controls={false}
                    show_title={false}
                    display_color_code="hide"
                />
            </div>
        ))}
    </div>
</details>

<script>
    // Mirrors explorer.astro's updateYearVisibility: the year input only matters for "annual".
    // Both params blocks below contain their own controls and dependent groups, so scoping to
    // the params element itself (rather than a shared ancestor) is enough to keep the two facet
    // panels independent.
    function wireVisibility(
        root: ParentNode,
        controlSelector: string,
        groupSelector: string,
        showWhen: string,
    ) {
        const control = root.querySelector<HTMLSelectElement>(controlSelector);
        const group = root.querySelector<HTMLElement>(groupSelector);
        if (!control || !group) return;
        function update() {
            group!.style.display = control!.value === showWhen ? "" : "none";
        }
        control.addEventListener("change", update);
        update();
    }

    document.querySelectorAll<HTMLElement>(".wt_params").forEach((el) => {
        wireVisibility(el, ".wt_time_frame", ".wt_year_group", "annual");
    });

    document.querySelectorAll<HTMLElement>(".ag_params").forEach((el) => {
        wireVisibility(el, ".ag_time_frame", ".ag_year_group", "annual");
    });
</script>

<script>
    // Every year input across the three facet panels shares this class; on committing an
    // out-of-range value, revert to whatever the field last held rather than clamping to
    // min/max, so a stray keystroke doesn't silently jump the user to a different year.
    document.querySelectorAll<HTMLInputElement>(".year-input").forEach((input) => {
        let lastValid = input.value;
        input.addEventListener("change", () => {
            const value = Number(input.value);
            const min = Number(input.min);
            const max = Number(input.max);
            if (Number.isNaN(value) || value < min || value > max) {
                input.value = lastValid;
            } else {
                lastValid = input.value;
            }
        });
    });
</script>

</Layout>
