---
import fs from "node:fs";
import { fileURLToPath } from "node:url";

interface Props {
  path?: string | null;
}

const { path: explicitPath = null } = Astro.props;

const dirRel = "data/graph_jsons/annual/per_agency";

// When no explicit path is given, list the hardcoded directory at build time
// so the client can pick a random graph from it on each page load.
let fallbackPaths: string[] = [];
if (!explicitPath) {
  const dirAbs = fileURLToPath(new URL(`../../public/${dirRel}`, import.meta.url));
  fallbackPaths = fs.readdirSync(dirAbs)
    .filter((f) => f.endsWith(".json"))
    .map((f) => `${dirRel}/${f}`);
}
---

<div
  id="hero-network"
  class="hero-network"
  data-path={explicitPath}
  data-fallback-paths={JSON.stringify(fallbackPaths)}
></div>

<script>
  // @ts-nocheck -- d3-force mutates plain node objects with x/y at runtime, which TS can't model here.
  import * as d3 from "d3";
  import { colors } from "../styles/colors.js";

  const container = document.getElementById("hero-network");
  const fallbackPaths = JSON.parse(container.dataset.fallbackPaths || "[]");
  const path = container.dataset.path || fallbackPaths[Math.floor(Math.random() * fallbackPaths.length)];

  const data = await fetch(path).then(r => {
    if (!r.ok) throw new Error(`Failed to fetch ${path}: ${r.status}`);
    return r.json();
  });

  const nodes = [...data.nodes].sort((a, b) => b.flow - a.flow).slice(0, 20)
  const links = [...data.links].filter(l => nodes.has(idOf(l.source)) && nodes.has(idOf(l.target))).map(d => ({ ...d }));

  const color = d3.scaleOrdinal([colors.accentRed, colors.accentGreen]);

  const width = 260, height = 200;
  const svg = d3.select("#hero-network").append("svg")
    .attr("viewBox", [0, 0, width, height])
    .attr("preserveAspectRatio", "xMidYMid meet")
    .style("width", "100%").style("height", "auto");

  const link = svg.append("g").attr("stroke", colors.linkStroke).attr("stroke-opacity", 0.6)
    .selectAll("line").data(links).join("line");

  const node = svg.append("g").attr("stroke", colors.nodeStroke).attr("stroke-width", 0.5)
    .selectAll("circle").data(nodes).join("circle")
    .attr("r", 8)
    .attr("fill", d => color(d.group))

  d3.forceSimulation(nodes)
    .force("link", d3.forceLink(links).id(d => d.id).distance(45))
    .force("charge", d3.forceManyBody().strength(-80))
    .force("x", d3.forceX(d => d.group === 0 ? width * 0.28 : width * 0.72).strength(0.15))
    .force("y", d3.forceY(height / 3).strength(0.15))
    .on("tick", () => {
      link.attr("x1", d => d.source.x).attr("y1", d => d.source.y)
          .attr("x2", d => d.target.x).attr("y2", d => d.target.y);
      node.attr("cx", d => d.x).attr("cy", d => d.y);
    });
</script>
