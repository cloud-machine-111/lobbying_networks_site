---
import Layout from "../layouts/Layout.astro";
import { AGENCIES, ALL_AGENCIES_VALUE } from "../scripts/agencies.js";
import Header from "../components/Header.astro";
import SiteTitle from "../components/SiteTitle.astro";
import AnnualFlowChart from "../components/annualflow_charts.astro";

// public/seals/<slug>_seal.png -- `&` is stripped from the agency value so the
// filename (and its URL) carries no characters a static host might choke on.
const sealSrc = (value) =>
  `/lobbying_networks_site/seals/${value.replace(/&/g, "and")}_seal.png`;
---

<style>
  .config {
    /* Full-bleed: cancel the html margin (8vw) + body padding on Layout so the
       gray box spans the whole viewport while the rest of the page stays inset.
       50% = half the content-area width, 50vw = half the viewport -> the
       difference is exactly the offset to each screen edge, no hardcoded 8vw. */
    width: 100vw;
    margin-top: -1lh;
    margin-left: calc(50% - 51vw);
    margin-right: calc(50% - 50vw);
    box-sizing: border-box;
    background: #e5e5e5;
    padding: 2rem 2rem .8rem 2rem;
    display: flex;
    flex-direction: row;
    gap: 1rem;
    font-weight: 100;
    font-style: italic;
    font-size: .9rem;
    line-height: .8lh;
    /* Freeze the config to the top of the viewport while the rest of the page
       scrolls past under it. The opaque gray background hides that content;
       z-index keeps it above the explorer windows and the fixed site header. */
    position: sticky;
    top: 0;
    z-index: 20;
    /* leave room so the collapse toggle (absolute, top-right) never overlaps text */
    padding-right: 7rem;
  }

  /* Collapse toggle: pinned top-right of the gray box, same green-outline look
     as the <select>s. Text ("collapse" / "expand") is swapped from JS. */
  .config__toggle {
    position: absolute;
    top: .6rem;
    right: .9rem;
    z-index: 1;
    font-family: "Times New Roman", Times, serif;
    font-size: .8rem;
    font-style: normal;
    color: var(--accentGreen);
    background: transparent;
    border: 1.5px solid var(--accentGreen);
    border-radius: 6px;
    padding: .2em .7em;
    cursor: pointer;
  }

  /* Shown only while collapsed, in place of the hidden lhs/rhs columns. */
  .config__collapsed-hint {
    display: none;
    align-self: center;
    font-style: normal;
    font-weight: 400;
    color: var(--accentBrown);
  }

  .config.collapsed {
    padding-top: .55rem;
    padding-bottom: .55rem;
  }

  .config.collapsed .lhs,
  .config.collapsed .rhs {
    display: none;
  }

  .config.collapsed .config__collapsed-hint {
    display: block;
  }

  /* 30:70 split of the space left after the flex gap. */
  .config .lhs {
    flex: 3 1 0;
    min-width: 0;
    /* Narrow green rule between the two columns (centered in the gap). */
    padding-right: 2rem;
    border-right: 1.5px solid var(--accentGreen);
    /* sizing reference for `cqw` units used by children (e.g. the "explore"
       label), so they track the column width like <SiteTitle /> does */
    container-type: inline-size;
  }

  /* Collapsible "how to use" blurb under the intro sentence. */
  .config .intro-more {
    font-size: .8rem;
  }

  .config .intro-more > summary {
    cursor: pointer;
    font-style: normal;
    font-weight: 400;
    color: var(--accentGreen);
    list-style: none;
  }

  .config .intro-more > summary::-webkit-details-marker {
    display: none;
  }

  .config .intro-more > summary::before {
    content: "\25B8 "; /* right-pointing triangle, rotates when open */
    display: inline-block;
    transition: transform .15s ease;
  }

  .config .intro-more[open] > summary::before {
    transform: rotate(90deg);
  }

  .config .rhs {
    flex: 13 1 0;
    min-width: 0;
    color: var(--accentBrown);
    font-size: smaller;
    /* sizing reference for the .config-row container queries below */
    container-type: inline-size;
  }

  /* Each option in "Build a network..." gets a green dashed, rounded box.
     All the same width (80% of the rhs column) and not touching each other. */
  .config-entry {
    width: 70%;
    box-sizing: border-box;
    margin: .7rem 0;
    padding:.8rem;
    border: 1.5px dashed var(--accentGreen);
    border-radius: 12px;
  }

  /* Grid (not flex-wrap) so the boxes never land 3-on-a-row with the 4th
     wrapping alone. Three fixed layouts, switched on the .rhs container width:
       - wide  : all four in a row, each capped narrower than its cell so the
                 row has breathing room (space-between spreads the slack)
       - mid   : 2 + 2
       - narrow: one per row  */
  .config-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @container (min-width: 56rem) {
    .config-row {
      grid-template-columns: repeat(4, minmax(0, 24rem));
      justify-content: space-between;
    }
  }

  @container (max-width: 28rem) {
    .config-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .config-row .config-entry {
    width: auto;
  }

  /* Weight box: one radio option per line. */
  .weight-entry .weight-option {
    display: block;
    margin-top: 0.4rem;
  }

  /* Too narrow: stack, lhs above rhs (lhs comes first in the DOM). */
  @media (max-width: 600px) {
    .config {
      flex-direction: column;
      /* toggle sits above the stacked columns here, so less side room needed */
      padding-right: 2rem;
      padding-top: 2.8rem;
    }

    .config .lhs {
      padding-right: 0;
      border-right: none;
      /* Green rule now runs horizontally between the stacked columns. */
      padding-bottom: 2rem;
      border-bottom: 1.5px solid var(--accentGreen);
    }
  }

  /* Radio options grouped in a bloc via a shared `name` (see markup);
     these rules just give the inputs a consistent custom look. */
  .radio_container {
    position: relative;
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: middle;
    cursor: pointer;
  }

  .radio_container input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .radio_mark {
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--nodeStroke);
    border-radius: 50%;
    background: transparent;
  }

  .radio_container input:checked ~ .radio_mark {
    background: var(--accentRed);
    box-shadow: inset 0 0 0 2px #e5e5e5;
  }

  /* Year slider: interactive while the "a year" time frame is selected, inert
     (see .year_slider.disabled below) while "all time" is selected.
     The draggable thumb is a small triangle that sits just below the track and
     points up at it; the current year sits right under the triangle
     (.year_bubble, positioned from JS). Circles mark each end. */
  .year_slider {
    margin-top: 1rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* "all time" selected: the slider stays in place but goes inert -- the
     track turns accentRed, the triangle thumb and year bubble disappear, and
     pointer/keyboard input is blocked. */
  .year_slider.disabled input[type="range"] {
    background: var(--accentRed);
    pointer-events: none;
    cursor: default;
  }

  .year_slider.disabled input[type="range"]::-webkit-slider-thumb {
    visibility: hidden;
  }

  .year_slider.disabled input[type="range"]::-moz-range-thumb {
    visibility: hidden;
  }

  .year_slider.disabled .year_bubble {
    visibility: hidden;
  }

  .range_wrap {
    position: relative;
    flex: 1 1 0;
    display: flex;
    align-items: center;
  }

  /* Fixed circles at the start and end of the timeline (same size as the
     thumb; sit exactly where the thumb centers at min / max). */
  .range_wrap::before,
  .range_wrap::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 1em;
    height: 1em;
    border-radius: 50%;
    background: var(--accentBrown);
    transform: translateY(-50%);
    pointer-events: none;
    /* sit in front of the range track (z-index: 1) */
    z-index: 2;
  }

  .range_wrap::before {
    left: 0;
  }

  .range_wrap::after {
    right: 0;
  }

  .year_slider input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    position: relative;
    z-index: 1;
    width: 100%;
    height: 2px;
    margin: 0;
    border-radius: 2px;
    background: color-mix(in srgb, var(--accentBrown) 60%, transparent);
    cursor: pointer;
    outline: none;
  }

  /* Triangle thumb: a solid box clipped to an upward-pointing triangle.
     translateY drops it below the 2px track so its apex points up at the
     line -- use transform, not margin-top: Firefox ignores margin on
     ::-moz-range-thumb. (A 0 x 0 border-triangle leaves a pale ghost
     triangle in webkit, so clip-path a real box instead.) */
  .year_slider input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 0.9em;
    height: 0.4em;
    border: none;
    border-radius: 0;
    background: var(--accentBrown);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    transform: translateY(1em);
    cursor: grab;
  }

  .year_slider input[type="range"]::-moz-range-thumb {
    width: 0.9em;
    height: 0.4em;
    border: none;
    border-radius: 0;
    background: var(--accentBrown);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    transform: translateY(1em);
    cursor: grab;
  }

  .year_bubble {
    position: absolute;
    top: calc(50% + 1.3em);
    transform: translateX(-50%);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  /* Interest-group selector box: question + dropdown on the left (LHS),
     agency seal on the right (RHS). */
  .agency-entry {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .agency-entry__main {
    flex: 1 1 0;
    min-width: 0;
  }

  /* long option labels can push the <select> wider than its column -- clamp it */
  .agency-entry__main select {
    max-width: 100%;
    box-sizing: border-box;
  }

  .agency-entry__seal {
    flex: 0 0 30%;
    min-width: 0;
  }

  .agency-entry__seal img {
    max-width: 100%;
    /* never taller than four lines of text */
    max-height: 5lh;
    height: auto;
    object-fit: contain;
  }

  /* match the <select> box in Layout.astro (same border, radius, padding...) */
  #nodes_shown {
    font-family: "Times New Roman", Times, serif;
    font-size: 1em;
    color: var(--accentBrown);
    background-color: transparent;
    border: 1px solid var(--accentGreen);
    border-radius: 6px;
    padding: 0.25em 0.5em;
    width: 5em;
    font-variant-numeric: tabular-nums;
  }

  /* Row 1: explorer + metadata side-by-side (flex-wrap stacks them once the row
     is too narrow -- see the container query below). flow-graph always sits on
     its own full-width row beneath both (100% flex-basis + order), never beside
     a sibling. All windows size themselves off their content and the flex
     layout -- no fixed dimensions; the network SVG scales via its viewBox. */
  .explorer-container {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    /* stretch (the default) so explorer + metadata share the taller one's
       height whenever they sit on the same row; metadata scrolls internally
       past that height (see below). Per-line, so the full-width flow-graph
       row and the wrapped-metadata case are unaffected. */
    align-items: stretch;
    /* let .metadata switch layout off the container's width, not the viewport's */
    container-type: inline-size;

    .window {
      color: white;
      background-color: var(--charcoal);
      border-radius: 20px;
      margin: .1rem;
      /* clip the injected SVG / panel to the rounded corners */
      overflow: hidden;
    }

    /* Definite height (not max-height): the injected svgWrap is height:100% and
       the svg inside is max-height:100%, so this value caps the graph. The
       square graph letterboxes to fit ("...meet") and the floating zoom
       controls / bill box stay pinned inside this clipped box. */
    .explorer {
      flex: 1 1 22rem;
      min-width: 0;
      height: 22lh;
    }

    /* Side-by-side with the explorer: metadata is a 30% column, explorer takes
       the rest. min-height: 0 + overflow-y lets its content scroll inside its
       own 30lh cap rather than pushing the row taller. */
    .metadata {
      flex: 0 1 30%;
      min-width: 0;
      min-height: 0;
      max-height: 22lh;
      overflow-y: auto;
    }

    /* Always a full-width row of its own, ordered after explorer + metadata. */
    .flow-graph {
      flex: 1 1 100%;
      min-width: 0;
      max-width: 25lh;
      order: 2;
      padding: 1rem 1.25rem;
    }

    /* The flow chart (<AnnualFlowChart>) is plain d3 with d3's default near-black
       axis ink -- recolor its runtime-injected axes/labels so they read on the
       charcoal window, and center the fixed-width chart. :global -- d3 builds the
       <g class="tick"> / .domain nodes after Astro has scoped this block, so they
       never carry the scope attribute a bare selector would look for. */
    .flow-graph :global(.af_chart) {
      margin: 0 auto;
    }

    .flow-graph :global(.af_title) {
      color: #fff;
      margin-top: 0.5rem;
    }

    .flow-graph :global(.tick text) {
      fill: #cfcfcf;
    }

    .flow-graph :global(.tick line),
    .flow-graph :global(.domain) {
      stroke: #666;
    }

    /* Container too narrow to seat a 30% panel next to the >= 22rem explorer:
       metadata drops to its own full-width row below both, no longer height-
       matched, so give it its own cap. */
    @container (max-width: 34rem) {
      .metadata {
        flex-basis: 100%;
        order: 1;
        max-height: 30lh;
      }
    }
  }
</style>

<Layout>
  <Header />
  <h1 style="display: none">Explore</h1>

  <div class="config" id="config">
    <button
      type="button"
      class="config__toggle"
      id="config_toggle"
      aria-controls="config"
      aria-expanded="true">collapse</button>
    <span class="config__collapsed-hint">network configuration</span>

    <div class="lhs">
      <SiteTitle min="1rem" ideal="10cqw" max="6rem" />

      <br />
      <div
        class="label"
        style="background: var(--accentGreen); font-size: clamp(.3rem, 13cqw, .8rem);"
      >
        explore networks
      </div>

      <p style="font-size: .8rem; line-height: 1lh;">
        Across year and federal environmental agency, explore communities of lobbyists with shared interests in bills.
      </p>

      <details class="intro-more">
        <summary>How to use this explorer</summary>
        <p style="font-size: .8rem; line-height: 1lh;">
          Click on <b style="font-weight: 700">two lobbyists sharing an edge</b> to explore bills they both lobbied on.
          <br /><br />
          Click a bill on the right panel to see which actors have lobbied it.
          <br /><br />
          <a href="/lobbying_networks_site/methodology">Read</a> about our methodology if you're curious!
        </p>
      </details>
    </div>

    <div class="rhs">
      <div class="label">Build a network...</div>

      <div class="config-row">
        <div class="config-entry agency-entry">
          <div class="agency-entry__main">
            For interest groups targeting which agency?
            <br /> <br />
            <select id="agency">
              {AGENCIES.map((a) => <option value={a.value}>{a.label}</option>)}
              <option value={ALL_AGENCIES_VALUE}>All agencies</option>
            </select>
          </div>
          <div class="agency-entry__seal">
            <img
              id="agency_seal"
              src={sealSrc(AGENCIES[0].value)}
              alt={`${AGENCIES[0].label} seal`}
            />
          </div>
        </div>

        <div class="config-entry">
          Across what time frame?
          <br /> <br />
          <label class="radio_container">
            <input type="radio" name="time_frame" value="annual" checked />
            <span class="radio_mark"></span>
          </label> a year

          <div style="width: 30%; display: inline-block"></div>

          <label class="radio_container">
            <input type="radio" name="time_frame" value="all" />
            <span class="radio_mark"></span>
          </label> all time

          <div class="year_slider" id="year_slider">
            <span>2006</span>
            <div class="range_wrap">
              <input
                type="range"
                id="year_input"
                name="year"
                min="2006"
                max="2021"
                step="1"
                value="2010"
              />
              <span class="year_bubble" id="year_bubble" aria-hidden="true"
                >2010</span
              >
            </div>
            <span>2021</span>
          </div>
        </div>

        <div class="config-entry weight-entry">
          How should edges be weighed?
          <br /> 

          <div class="weight-option">
            <label class="radio_container">
              <input type="radio" name="weight" value="bills" checked />
              <span class="radio_mark"></span>
            </label> bills
          </div>

          <div class="weight-option">
            <label class="radio_container">
              <input type="radio" name="weight" value="spending_bills" />
              <span class="radio_mark"></span>
            </label> spending × bills
          </div>

          <div class="weight-option">
            <label class="radio_container">
              <input type="radio" name="weight" value="ln_spending_bills" />
              <span class="radio_mark"></span>
            </label> ln(spending) × bills
          </div>
        </div>

        <div class="config-entry">
          How many nodes shown?
          <br /> <br />
          <input
            type="number"
            id="nodes_shown"
            name="nodes_shown"
            min="1"
            max="300"
            step="1"
            value="20"
          />
        </div>
      </div>
    </div>
  </div>

  <br />
  <!-- <br /> -->

  <div class="explorer-container" style="max-width: 70rem;">

    <div class="window explorer" id="nwk-explorer"></div>

    <div class="window metadata" id="nwk-metadata"></div>

    <div class="window flow-graph">
      <!-- Hidden proxy the <AnnualFlowChart> weight_selector watches; kept in sync
           with the "weight" radios by the flow-chart script block below. -->
      <select id="flow_weight" hidden>
        <option value="base">base</option>
        <option value="spending_unlogged">spending_unlogged</option>
        <option value="spending_logged">spending_logged</option>
      </select>

      <AnnualFlowChart
        show_controls={false}
        width={760}
        agency_selector="#agency"
        weight_selector="#flow_weight"
      />
    </div>
  </div>

  hi. problem right now - tractable just annoying - is that I want all 3 components to tile satisfyingly and also appear on the screen at the same time.

  2 options:

  (1) make the selector also appear as a tile
  (2) don't have all components tile on the same screen, but add scrolly sidebar do jump between them, & freeze but collapse config when you scroll down.
  <br> <br>
</Layout>

<script>
  const slider = document.getElementById("year_slider") as HTMLDivElement;
  const yearInput = document.getElementById("year_input") as HTMLInputElement;
  const yearBubble = document.getElementById("year_bubble") as HTMLSpanElement;
  const timeFrameRadios = document.querySelectorAll<HTMLInputElement>(
    'input[name="time_frame"]',
  );

  // Triangle thumb is 0.9em wide in CSS; match it here so the year bubble tracks
  // the thumb centre across the whole track (the thumb can't leave the track).
  const THUMB_EM = 0.9;

  function positionBubble() {
    const min = +yearInput.min;
    const max = +yearInput.max;
    const val = +yearInput.value;
    const pct = (val - min) / (max - min);
    const fontPx = parseFloat(getComputedStyle(yearInput).fontSize);
    const thumbPx = THUMB_EM * fontPx;
    const track = yearInput.clientWidth;
    yearBubble.textContent = String(val);
    yearBubble.style.left = `${pct * (track - thumbPx) + thumbPx / 2}px`;
  }

  function syncSlider() {
    const annual =
      document.querySelector<HTMLInputElement>(
        'input[name="time_frame"]:checked',
      )?.value === "annual";
    slider.classList.toggle("disabled", !annual);
    yearInput.disabled = !annual;
    if (annual) positionBubble();
  }

  // Swap the seal image whenever the agency changes. Files live in
  // public/seals/ as `<agency value>_seal.png`, with `&` rewritten to "and"
  // (matches sealSrc in the frontmatter); "All agencies" has no seal.
  const agencySelect = document.getElementById("agency") as HTMLSelectElement;
  const agencySeal = document.getElementById("agency_seal") as HTMLImageElement;
  const ALL_AGENCIES_VALUE = "x_agy";

  function syncSeal() {
    const opt = agencySelect.selectedOptions[0];
    if (!opt || opt.value === ALL_AGENCIES_VALUE) {
      agencySeal.hidden = true;
      agencySeal.removeAttribute("src");
      return;
    }
    agencySeal.hidden = false;
    agencySeal.src = `/lobbying_networks_site/seals/${opt.value.replace(/&/g, "and")}_seal.png`;
    agencySeal.alt = `${opt.textContent ?? ""} seal`;
  }

  agencySelect.addEventListener("change", syncSeal);
  syncSeal();

  timeFrameRadios.forEach((r) => r.addEventListener("change", syncSlider));
  yearInput.addEventListener("input", positionBubble);
  window.addEventListener("resize", positionBubble);

  syncSlider();

  // Collapse toggle for the frozen (sticky) config bar. Collapsed state is
  // remembered per-browser so it survives reloads.
  const config = document.getElementById("config") as HTMLDivElement;
  const configToggle = document.getElementById(
    "config_toggle",
  ) as HTMLButtonElement;
  const CONFIG_COLLAPSED_KEY = "explorer2:configCollapsed";

  function setConfigCollapsed(collapsed: boolean) {
    config.classList.toggle("collapsed", collapsed);
    configToggle.setAttribute("aria-expanded", String(!collapsed));
    configToggle.textContent = collapsed ? "expand" : "collapse";
    try {
      localStorage.setItem(CONFIG_COLLAPSED_KEY, collapsed ? "1" : "0");
    } catch {
      /* storage unavailable (private mode etc.) — non-fatal */
    }
  }

  configToggle.addEventListener("click", () =>
    setConfigCollapsed(!config.classList.contains("collapsed")),
  );

  try {
    if (localStorage.getItem(CONFIG_COLLAPSED_KEY) === "1")
      setConfigCollapsed(true);
  } catch {
    /* ignore */
  }

  // The max/min attrs don't stop manual typing, so clamp to [1, 300] on blur.
  const nodesShown = document.getElementById("nodes_shown") as HTMLInputElement;
  nodesShown.addEventListener("change", () => {
    const lo = +nodesShown.min;
    const hi = +nodesShown.max;
    const val = Math.round(+nodesShown.value);
    nodesShown.value = String(
      Number.isNaN(val)
        ? nodesShown.defaultValue
        : Math.min(hi, Math.max(lo, val)),
    );
  });
</script>

<script>
  // Network explorer + side panel, ported from explorer.astro's Observable-runtime setup to
  // plain d3 (src/scripts/nwk_explorer.js). This block just maps explorer_2's controls onto
  // the dataset-path shape the module expects and re-renders on any change. Registered after
  // the block above so #nodes_shown is clamped before render() reads it.
  import { loadGraph, renderNetworkExplorer } from "../scripts/nwk_explorer.js";
  import { datasetPathFor } from "../scripts/graph_utils.js";

  const graphEl = document.getElementById("nwk-explorer")!;
  const panelEl = document.getElementById("nwk-metadata")!;
  const agencySelect = document.getElementById("agency") as HTMLSelectElement;
  const yearInputEl = document.getElementById("year_input") as HTMLInputElement;
  const nodesShownEl = document.getElementById("nodes_shown") as HTMLInputElement;

  // explorer_2 folds explorer.astro's separate weight_type + log selects into one three-way
  // "weight" radio, and says "all" where explorer.astro said "aggregate". Unfold both back to
  // the (agency, weightType, timeFrame, yr, log) shape datasetPathFor() expects.
  function resolveParams() {
    const timeFrameRaw =
      document.querySelector<HTMLInputElement>('input[name="time_frame"]:checked')?.value ??
      "annual";
    const weightRaw =
      document.querySelector<HTMLInputElement>('input[name="weight"]:checked')?.value ?? "bills";

    return {
      agency: agencySelect.value,
      weightType: weightRaw === "bills" ? "base" : "spending",
      log: weightRaw === "ln_spending_bills" ? "logged" : "unlogged",
      timeFrame: timeFrameRaw === "all" ? "aggregate" : "annual",
      year: Number(yearInputEl.value),
      nodesShown: Number(nodesShownEl.value),
    };
  }

  // Only the newest render() call may touch the DOM — guards against a slow fetch resolving
  // after a later control change has already kicked off its own render.
  let renderToken = 0;
  let teardown: (() => void) | null = null;

  async function render() {
    const token = ++renderToken;
    const { agency, weightType, log, timeFrame, year, nodesShown } = resolveParams();
    const path = datasetPathFor(agency, weightType, timeFrame, year, log);

    let data: any = null;
    try {
      data = await loadGraph(path);
    } catch {
      data = null;
    }
    if (token !== renderToken) return;

    teardown?.();
    teardown = null;
    graphEl.textContent = "";
    panelEl.textContent = "";

    if (!data) {
      graphEl.textContent = "No network dataset for this combination.";
      return;
    }
    teardown = renderNetworkExplorer({ graphEl, panelEl, data, nodesShown });
  }

  agencySelect.addEventListener("change", render);
  yearInputEl.addEventListener("change", render);
  nodesShownEl.addEventListener("change", render);
  document
    .querySelectorAll('input[name="time_frame"], input[name="weight"]')
    .forEach((el) => el.addEventListener("change", render));

  render();
</script>

<script>
  // Flow-through-time chart, ported from explorer.astro's "Explore flow through time" section
  // (<AnnualFlowChart>). That component already runs on plain d3, so the port is just wiring:
  // it follows explorer_2's shared #agency select directly (agency_selector prop), and this
  // block mirrors the three-way "weight" radio onto the hidden #flow_weight <select> the
  // component's weight_selector prop watches. explorer_2's radio values don't match the
  // component's weight keys, so remap here -- the same unfold the network block's
  // resolveParams() does for datasetPathFor().
  const flowWeight = document.getElementById("flow_weight") as HTMLSelectElement;
  const WEIGHT_KEY: Record<string, string> = {
    bills: "base",
    spending_bills: "spending_unlogged",
    ln_spending_bills: "spending_logged",
  };

  function syncFlowWeight() {
    const weightRaw =
      document.querySelector<HTMLInputElement>('input[name="weight"]:checked')?.value ?? "bills";
    const next = WEIGHT_KEY[weightRaw] ?? "base";
    if (flowWeight.value === next) return;
    flowWeight.value = next;
    flowWeight.dispatchEvent(new Event("change", { bubbles: true }));
  }

  document
    .querySelectorAll('input[name="weight"]')
    .forEach((el) => el.addEventListener("change", syncFlowWeight));

  syncFlowWeight();
</script>
