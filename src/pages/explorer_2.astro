---
import Layout from "../layouts/Layout.astro";
import { AGENCIES, ALL_AGENCIES_VALUE } from "../scripts/agencies.js";
import Header from "../components/Header.astro";
import SiteTitle from "../components/SiteTitle.astro";

// public/seals/<slug>_seal.png -- `&` is stripped from the agency value so the
// filename (and its URL) carries no characters a static host might choke on.
const sealSrc = (value) =>
  `/lobbying_networks_site/seals/${value.replace(/&/g, "and")}_seal.png`;
---

<style>
  .config {
    /* Full-bleed: cancel the html margin (8vw) + body padding on Layout so the
       gray box spans the whole viewport while the rest of the page stays inset.
       50% = half the content-area width, 50vw = half the viewport -> the
       difference is exactly the offset to each screen edge, no hardcoded 8vw. */
    width: 100vw;
    margin-left: calc(50% - 51vw);
    margin-right: calc(50% - 50vw);
    box-sizing: border-box;
    background: #e5e5e5;
    padding: 2rem;
    display: flex;
    flex-direction: row;
    gap: 1rem;
    font-weight: 100;
    font-style: italic;
  }

  /* 30:70 split of the space left after the flex gap. */
  .config .lhs {
    flex: 3 1 0;
    min-width: 0;
    /* Narrow green rule between the two columns (centered in the gap). */
    padding-right: 2rem;
    border-right: 1.5px solid var(--accentGreen);
    /* sizing reference for `cqw` units used by children (e.g. the "explore"
       label), so they track the column width like <SiteTitle /> does */
    container-type: inline-size;
  }

  .config .rhs {
    flex: 7 1 0;
    min-width: 0;
    color: var(--accentBrown);
    font-size: smaller;
  }

  /* Each option in "Build a network..." gets a green dashed, rounded box.
     All the same width (80% of the rhs column) and not touching each other. */
  .config-entry {
    width: 80%;
    box-sizing: border-box;
    margin: .8rem 0;
    padding:.8rem;
    border: 1px dashed var(--accentGreen);
    border-radius: 12px;
  }

  /* First two boxes sit side-by-side; flex-wrap drops them back to a stack
     once the column is too narrow to fit both (each wants >= 16rem). */
  .config-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .config-row .config-entry {
    width: auto;
    flex: 1 1 16rem;
  }

  /* Too narrow: stack, lhs above rhs (lhs comes first in the DOM). */
  @media (max-width: 800px) {
    .config {
      flex-direction: column;
    }

    .config .lhs {
      padding-right: 0;
      border-right: none;
      /* Green rule now runs horizontally between the stacked columns. */
      padding-bottom: 2rem;
      border-bottom: 1.5px solid var(--accentGreen);
    }
  }

  /* Radio options grouped in a bloc via a shared `name` (see markup);
     these rules just give the inputs a consistent custom look. */
  .radio_container {
    position: relative;
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: middle;
    cursor: pointer;
  }

  .radio_container input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .radio_mark {
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--nodeStroke);
    border-radius: 50%;
    background: transparent;
  }

  .radio_container input:checked ~ .radio_mark {
    background: var(--accentRed);
    box-shadow: inset 0 0 0 2px #e5e5e5;
  }

  /* Year slider: interactive while the "a year" time frame is selected, inert
     (see .year_slider.disabled below) while "all time" is selected.
     The draggable thumb is a small triangle that sits just below the track and
     points up at it; the current year sits right under the triangle
     (.year_bubble, positioned from JS). Circles mark each end. */
  .year_slider {
    margin-top: 1rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* "all time" selected: the slider stays in place but goes inert -- the
     track turns accentRed, the triangle thumb and year bubble disappear, and
     pointer/keyboard input is blocked. */
  .year_slider.disabled input[type="range"] {
    background: var(--accentRed);
    pointer-events: none;
    cursor: default;
  }

  .year_slider.disabled input[type="range"]::-webkit-slider-thumb {
    visibility: hidden;
  }

  .year_slider.disabled input[type="range"]::-moz-range-thumb {
    visibility: hidden;
  }

  .year_slider.disabled .year_bubble {
    visibility: hidden;
  }

  .range_wrap {
    position: relative;
    flex: 1 1 0;
    display: flex;
    align-items: center;
  }

  /* Fixed circles at the start and end of the timeline (same size as the
     thumb; sit exactly where the thumb centers at min / max). */
  .range_wrap::before,
  .range_wrap::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 1em;
    height: 1em;
    border-radius: 50%;
    background: var(--accentBrown);
    transform: translateY(-50%);
    pointer-events: none;
    /* sit in front of the range track (z-index: 1) */
    z-index: 2;
  }

  .range_wrap::before {
    left: 0;
  }

  .range_wrap::after {
    right: 0;
  }

  .year_slider input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    position: relative;
    z-index: 1;
    width: 100%;
    height: 2px;
    margin: 0;
    border-radius: 2px;
    background: color-mix(in srgb, var(--accentBrown) 60%, transparent);
    cursor: pointer;
    outline: none;
  }

  /* Triangle thumb: a solid box clipped to an upward-pointing triangle.
     translateY drops it below the 2px track so its apex points up at the
     line -- use transform, not margin-top: Firefox ignores margin on
     ::-moz-range-thumb. (A 0 x 0 border-triangle leaves a pale ghost
     triangle in webkit, so clip-path a real box instead.) */
  .year_slider input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 0.9em;
    height: 0.4em;
    border: none;
    border-radius: 0;
    background: var(--accentBrown);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    transform: translateY(1em);
    cursor: grab;
  }

  .year_slider input[type="range"]::-moz-range-thumb {
    width: 0.9em;
    height: 0.4em;
    border: none;
    border-radius: 0;
    background: var(--accentBrown);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    transform: translateY(1em);
    cursor: grab;
  }

  .year_bubble {
    position: absolute;
    top: calc(50% + 1.3em);
    transform: translateX(-50%);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  /* Interest-group selector box: question + dropdown on the left (LHS),
     agency seal on the right (RHS). */
  .agency-entry {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .agency-entry__main {
    flex: 1 1 0;
    min-width: 0;
  }

  /* long option labels can push the <select> wider than its column -- clamp it */
  .agency-entry__main select {
    max-width: 100%;
    box-sizing: border-box;
  }

  .agency-entry__seal {
    flex: 0 0 30%;
    min-width: 0;
  }

  .agency-entry__seal img {
    max-width: 100%;
    /* never taller than four lines of text */
    max-height: 6lh;
    height: auto;
    object-fit: contain;
  }

  /* match the <select> box in Layout.astro (same border, radius, padding...) */
  #nodes_shown {
    font-family: "Times New Roman", Times, serif;
    font-size: 1em;
    color: var(--accentBrown);
    background-color: transparent;
    border: 1px solid var(--accentGreen);
    border-radius: 6px;
    padding: 0.25em 0.5em;
    width: 5em;
    font-variant-numeric: tabular-nums;
  }
</style>

<Layout>
  <Header />
  <h1 style="display: none">Explore</h1>

  <div class="config">
    <div class="lhs">
      <SiteTitle min="1rem" />

      <br />
      <div
        class="label"
        style="background: var(--accentGreen); font-size: clamp(.5rem, 13cqw, 1rem);"
      >
        explore networks
      </div>

      <p style="font-size: smaller;">
        From 2006-2021, across 12 federal environmental agencies, explore the
        communities of lobbyists who've been interested in the same groups of
        bills.
        <br />
        <br />
        If you're curious about our methodology, <a
          href="/lobbying_networks_site/methodology">click</a
        > to read about it!
      </p>
    </div>

    <div class="rhs">
      <div class="label">Build a network...</div>

      <div class="config-row">
        <div class="config-entry agency-entry">
          <div class="agency-entry__main">
            for interest groups targeting which agency?
            <br /> <br />
            <select id="agency">
              {AGENCIES.map((a) => <option value={a.value}>{a.label}</option>)}
              <option value={ALL_AGENCIES_VALUE}>All agencies</option>
            </select>
          </div>
          <div class="agency-entry__seal">
            <img
              id="agency_seal"
              src={sealSrc(AGENCIES[0].value)}
              alt={`${AGENCIES[0].label} seal`}
            />
          </div>
        </div>

        <div class="config-entry">
          across what time frame?
          <br /> <br />
          <label class="radio_container">
            <input type="radio" name="time_frame" value="annual" checked />
            <span class="radio_mark"></span>
          </label> a year

          <div style="width: 30%; display: inline-block"></div>

          <label class="radio_container">
            <input type="radio" name="time_frame" value="all" />
            <span class="radio_mark"></span>
          </label> all time

          <div class="year_slider" id="year_slider">
            <span>2006</span>
            <div class="range_wrap">
              <input
                type="range"
                id="year_input"
                name="year"
                min="2006"
                max="2021"
                step="1"
                value="2010"
              />
              <span class="year_bubble" id="year_bubble" aria-hidden="true"
                >2010</span
              >
            </div>
            <span>2021</span>
          </div>
        </div>
      </div>

      <div class="config-entry">
        How should edges be weighed?
        <br />

        <label class="radio_container">
          <input type="radio" name="weight" value="bills" checked />
          <span class="radio_mark"></span>
        </label> bills
        <br />

        <label class="radio_container">
          <input type="radio" name="weight" value="spending_bills" />
          <span class="radio_mark"></span>
        </label> spending × bills
        <br />

        <label class="radio_container">
          <input type="radio" name="weight" value="ln_spending_bills" />
          <span class="radio_mark"></span>
        </label> ln(spending) × bills
      </div>
    </div>
  </div>

  <br />
  <br />

  <div class="label">Nodes shown:</div> &nbsp;
  <input
    type="number"
    id="nodes_shown"
    name="nodes_shown"
    min="1"
    max="300"
    step="1"
    value="20"
  />

  <br />
  <br />
  explorer here!
  <br> <br>
</Layout>

<script>
  const slider = document.getElementById("year_slider") as HTMLDivElement;
  const yearInput = document.getElementById("year_input") as HTMLInputElement;
  const yearBubble = document.getElementById("year_bubble") as HTMLSpanElement;
  const timeFrameRadios = document.querySelectorAll<HTMLInputElement>(
    'input[name="time_frame"]',
  );

  // Triangle thumb is 0.9em wide in CSS; match it here so the year bubble tracks
  // the thumb centre across the whole track (the thumb can't leave the track).
  const THUMB_EM = 0.9;

  function positionBubble() {
    const min = +yearInput.min;
    const max = +yearInput.max;
    const val = +yearInput.value;
    const pct = (val - min) / (max - min);
    const fontPx = parseFloat(getComputedStyle(yearInput).fontSize);
    const thumbPx = THUMB_EM * fontPx;
    const track = yearInput.clientWidth;
    yearBubble.textContent = String(val);
    yearBubble.style.left = `${pct * (track - thumbPx) + thumbPx / 2}px`;
  }

  function syncSlider() {
    const annual =
      document.querySelector<HTMLInputElement>(
        'input[name="time_frame"]:checked',
      )?.value === "annual";
    slider.classList.toggle("disabled", !annual);
    yearInput.disabled = !annual;
    if (annual) positionBubble();
  }

  // Swap the seal image whenever the agency changes. Files live in
  // public/seals/ as `<agency value>_seal.png`, with `&` rewritten to "and"
  // (matches sealSrc in the frontmatter); "All agencies" has no seal.
  const agencySelect = document.getElementById("agency") as HTMLSelectElement;
  const agencySeal = document.getElementById("agency_seal") as HTMLImageElement;
  const ALL_AGENCIES_VALUE = "x_agy";

  function syncSeal() {
    const opt = agencySelect.selectedOptions[0];
    if (!opt || opt.value === ALL_AGENCIES_VALUE) {
      agencySeal.hidden = true;
      agencySeal.removeAttribute("src");
      return;
    }
    agencySeal.hidden = false;
    agencySeal.src = `/lobbying_networks_site/seals/${opt.value.replace(/&/g, "and")}_seal.png`;
    agencySeal.alt = `${opt.textContent ?? ""} seal`;
  }

  agencySelect.addEventListener("change", syncSeal);
  syncSeal();

  timeFrameRadios.forEach((r) => r.addEventListener("change", syncSlider));
  yearInput.addEventListener("input", positionBubble);
  window.addEventListener("resize", positionBubble);

  syncSlider();

  // The max/min attrs don't stop manual typing, so clamp to [1, 300] on blur.
  const nodesShown = document.getElementById("nodes_shown") as HTMLInputElement;
  nodesShown.addEventListener("change", () => {
    const lo = +nodesShown.min;
    const hi = +nodesShown.max;
    const val = Math.round(+nodesShown.value);
    nodesShown.value = String(
      Number.isNaN(val)
        ? nodesShown.defaultValue
        : Math.min(hi, Math.max(lo, val)),
    );
  });
</script>
