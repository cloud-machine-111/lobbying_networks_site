---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import { AGENCIES, ALL_AGENCIES_VALUE } from "../scripts/agencies.js";
import Header from "../components/Header.astro";
import AnnualFlowChart from "../components/annualflow_charts.astro";
import FacetedFlows from "../components/faceted_flow_graphs.astro";
import FacetedNwks from "../components/faceted_nwk_graphs.astro";
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
  <h1>Explore</h1>


    <div style="font-style: italic; color: var(--lightBrown)">
      <b
        >From 2000-2021, across 13 federal environmental agencies, explore the
        communities of lobbyists who've been interested in the same groups of
        bills.</b
      >
      <br />
      <br />
      To make these graphs, we drew edges between each pair of lobbyists who lobbied
      the same federal agency over at least 1 common bill. We weigh the edges by intensity
      of lobbying activity: for <b>base</b> weight, each bill adds 1 to edge weight,
      and for <b>spending</b> weight, we multiply bill count by spending. There is
      the option to <b>logarithmize</b> spending, as it's reasonable to assume spending
      has diminishing returns.
      <br />
      <br />
      We then run our graphs through a random-walk-based <b
        >community detection algorithm</b
      >, such that political actors working on dense clusters of similar bills
      are grouped together. Edge <b>"flow"</b> represents the proportion of time the
      random walker spends on a given edge - think of it as a normalized version of
      lobbying intensity.
      <br />
      <br />
      If you're curious about our methodology, <a
        href="/lobbying_networks_site/methodology">click</a> to read about it! TODO: add dynamic vertical table of contents so ppl know what they're looking at.
    </div>

  <div class="explorer">
    <h2><i>1. explore networks </i></h2>

    <div class="params">
      <span id="year_group">
        <label for="yr_input"><b>Year: </b></label>
        <input
          type="number"
          id="yr_input"
          name="year"
          min="2000"
          max="2021"
          value="2011"
        />
      </span>

      &nbsp; &nbsp;

      <span id="log_group">
        <b>Spending: </b> &nbsp;
        <select id="log">
          <option value="logged">log(spending)</option>
          <option value="unlogged">plain spending</option>
        </select>
      </span>

      &nbsp; &nbsp;

      <b>Time frame: </b> &nbsp;
      <select id="time_frame">
        <option value="annual">annual</option>
        <option value="aggregate">aggregate</option>
      </select>

      &nbsp;&nbsp;

      <b>Agency: </b> &nbsp;
      <select id="agency">
        {AGENCIES.map((a) => <option value={a.value}>{a.label}</option>)}
        <option value={ALL_AGENCIES_VALUE}>All agencies</option>
      </select>

      &nbsp;&nbsp;

      <b>Weight type: </b> &nbsp;
      <select id="weight_type">
        <option value="base">base</option>
        <option value="spending">spending</option>
      </select>

      <div id="slider-container"></div>
    </div>

    <br />

    <div id="chart-container" class="chart-container"></div>

    <br />
    <!-- <button id="screenshot-btn" type="button"> Download chart </button> -->

    <!-- <button id="batch-btn" type="button">Run all screenshots</button> -->

    <br /><br /> <br /><br /> <br /><br />
    <h2><i>2. Explore flow through time</i></h2>
    <br />

    <AnnualFlowChart show_controls={true} />

    <br /><br /> <br /><br /> <br /><br />

    <h2><i>3. Compare networks & flow through time.</i></h2>
    Explore <a href="#facet-flow">flow through time</a> &nbsp · &nbsp Explore <a
      href="#facet-nwks">networks through time</a
    >

    <div id="facet-flow" class="facet-section">
      <FacetedFlows />
    </div>
    <div id="facet-nwks" class="facet-section">
      <FacetedNwks />
    </div>

    <style>
      .facet-section {
        display: none;
      }
    </style>

    <script>
      function showFacetSection() {
        document
          .querySelectorAll<HTMLElement>(".facet-section")
          .forEach((el) => {
            el.style.display =
              `#${el.id}` === window.location.hash ? "block" : "none";
          });
      }

      window.addEventListener("hashchange", showFacetSection);
      showFacetSection();
    </script>

    <br />
    <script type="module">
      /////// EXPLORER WINDOW /////
      import define from "../scripts/index.js";
      import { Runtime, Library, Inspector } from "../scripts/runtime.js";
      import { AGENCIES, ALL_AGENCIES_VALUE } from "../scripts/agencies.js";

      const runtime = new Runtime();
      // runtime.module = method that calls a function (within Observable runtime) & parameterizes it.
      const main = runtime.module(define, (name) => {
        if (name === "chart")
          return new Inspector(document.getElementById("chart-container")); // gets empty div, push cell value into div.

        if (name === "viewof NODES_SHOWN")
          return new Inspector(document.getElementById("slider-container"));
        return null; // suppresses printouts.
      });

      // Add a new cell from outside observable_nwk_viz.js, using the returned `main`
      main.variable(null).define("DATASET_PATH", [], () => buildDatasetPath());

      function buildDatasetPath() {
        const log = document.getElementById("log").value;
        const timeFrame = document.getElementById("time_frame").value;
        const agency = document.getElementById("agency").value;
        const weightType = document.getElementById("weight_type").value;
        const yr = document.getElementById("yr_input").value;

        // x_agy (the "All agencies" option) is filed under "all_agys" in the data.
        const agy_file_str = agency == "x_agy" ? "all_agys" : agency;
        const period = timeFrame == "aggregate" ? "aggregate" : yr;

        let path = "";
        if (weightType == "base") {
          // base weights have no logged/unlogged split.
          path = `/nwks_base_weights/final_${agy_file_str}_${period}_infomap.json`;
        } else {
          const log_str = log == "logged" ? "log" : "nolog";
          path = `/nwks_spending_weights/final_${log_str}_${agy_file_str}_${period}_infomap.json`;
        }
        console.log(path);
        return path;
      }

      ["log", "time_frame", "agency", "weight_type", "yr_input"].forEach(
        (id) => {
          document.getElementById(id).addEventListener("change", () => {
            main.redefine("DATASET_PATH", buildDatasetPath());
          });
        },
      );

      function updateYearVisibility() {
        const timeFrame = document.getElementById("time_frame").value;
        document.getElementById("year_group").style.display =
          timeFrame === "annual" ? "" : "none";
      }

      document
        .getElementById("time_frame")
        .addEventListener("change", updateYearVisibility);

      updateYearVisibility(); // called once during page load, then never again

      function updateLogVisibility() {
        const weightType = document.getElementById("weight_type").value;
        document.getElementById("log_group").style.display =
          weightType === "spending" ? "" : "none";
      }

      document
        .getElementById("weight_type")
        .addEventListener("change", updateLogVisibility);

      updateLogVisibility(); // called once during page load, then never again

      ////// SCREENSHOTTING //////
      import { toPng } from "https://esm.sh/html-to-image@1.11.11";

      document
        .getElementById("screenshot-btn")
        ?.addEventListener("click", async () => {
          const node = document.getElementById("chart-container");
          try {
            const dataUrl = await toPng(node, {
              backgroundColor: "#000", // matches dark chart background
              pixelRatio: 2, // sharper output on retina screens
            });

            const link = document.createElement("a");
            let filepath = `chart${buildDatasetPath().replace("/data/", "_").replace("final_", "").replace(".json", ".png").replaceAll("/", "_")}`;
            link.download = filepath;
            link.href = dataUrl;
            link.click();
          } catch (err) {
            console.error("Screenshot failed:", err);
          }
        });

      ////// downloadin
      // import { toPng } from "https://esm.sh/html-to-image@1.11.11";

      const AGENCY_VALUES = [
        ...AGENCIES.map((a) => a.value),
        ALL_AGENCIES_VALUE,
      ];
      const WEIGHT_TYPES = ["base", "spending"];
      const LOG_OPTIONS = ["logged", "unlogged"];

      function setSelect(id, value) {
        const el = document.getElementById(id);
        el.value = value;
        el.dispatchEvent(new Event("change", { bubbles: true }));
      }

      function sleep(ms) {
        return new Promise((resolve) => setTimeout(resolve, ms));
      }

      async function screenshotCurrentChart(filename) {
        const node = document.getElementById("chart-container");
        const dataUrl = await toPng(node, {
          backgroundColor: "#000",
          pixelRatio: 2,
        });
        const link = document.createElement("a");
        link.download = filename;
        link.href = dataUrl;
        link.click();
      }

      async function runBatchScreenshots({
        dryRun = false,
        settleMs = 1200,
        verbose = true,
      } = {}) {
        setSelect("time_frame", "aggregate");

        let count = 0;
        for (const agency of AGENCY_VALUES) {
          for (const weightType of WEIGHT_TYPES) {
            for (const log of LOG_OPTIONS) {
              count++;
              const label = `${agency} | ${weightType} | ${log}`;

              if (dryRun) {
                console.log(`[dry run ${count}]`, label);
                continue; // skip the actual work, just print what would happen
              }

              if (verbose) console.log(`[${count}] setting`, label);
              setSelect("agency", agency);
              setSelect("weight_type", weightType);
              setSelect("log", log);

              await sleep(settleMs); // let the fetch + redraw finish

              const filename = `chart_${agency}_${weightType}_${log}.png`;
              if (verbose)
                console.log(`[${count}] screenshotting ->`, filename);

              try {
                await screenshotCurrentChart(filename);
              } catch (err) {
                console.error(`[${count}] FAILED on`, label, err);
              }
            }
          }
        }

        console.log(`Done. ${count} configurations processed.`);
      }

      document
        .getElementById("batch-btn")
        ?.addEventListener("click", () =>
          runBatchScreenshots({ dryRun: false }),
        );
    </script>

    <style>
      .chart-container {
        display: flex;
        justify-content: center;
      }
    </style>
  </div>
</Layout>
