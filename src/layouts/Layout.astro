---
import { colors } from "../styles/colors";
import Header from "../components/Header.astro";
import Text from "./Text.astro";
import favicon from "../assets/RESL_Circular_logo.png";

const { style } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>Networks in Environmental Lobbying</title>
	</head>
	<body style={style}>
		<canvas id="canvas"></canvas>
		<slot />
	</body>

	<center style="font-size: smaller; font-style: italic; color: var(--lightBrown)">© 2026 RESL Lab</center>
</html>

<Text />
<Header />
<style is:global define:vars={colors}>
	html {
		margin: 3vh 8vw;

		.hero {
			@media (max-width: 1000px) {
				width: 80vw;
			}
		}
	}

	.hero {
		position: relative;
		/* Without this, a positioned descendant with z-index:-1 (the hero-network svg)
		   doesn't stack "behind this element's other children" — position:relative alone
		   doesn't create a stacking context, so the negative z-index falls through to the
		   document root and lands behind unrelated ancestors, breaking hit-testing (drag). */
		isolation: isolate;
		height: 50vh;
		width: 60vw;
		display: flex;
		/* align-items: center; */
		justify-content: top;
		flex-direction: column;
		margin: 7.5vh 40px;


		.content {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 2em;
		}

		.hero-network {
			/* Flex footprint stays the same so surrounding text/layout don't shift; the
			   rendered svg itself escapes this box (see below) to appear as a large,
			   dimmed background behind the whole hero. */
			flex: 0 0 20%;
			width: 30vw;
			height: 50%;
			position: relative;
			overflow: visible;
			z-index: -1;
			pointer-events: none;

			svg {
				/* d3 sets width/height as inline styles on the svg element, which beat any
				   non-!important rule here regardless of selector specificity. */
				position: absolute !important;
				/* Re-enable hit-testing so node drag still works; the container above stays
				   pointer-events: none so the rest of the (mostly transparent) box doesn't
				   block clicks on the text/buttons layered in front of it. */
				pointer-events: auto;
				top: 50%;
				left: 50%;
				width: 65vw !important;
				height: auto !important;
				transform: translate(-50%, -50%);
				opacity: 0.35;
			}
		}
	}


		.button {
			border: var(--nodeStroke) solid 0.5px;
			margin: 5% 5% 0px 0px;
			padding: 15px 32px;
			text-align: center;
			text-decoration: none;
			display: inline-block;
			font-size: 16px;
			cursor: pointer;
			color: var(--accentBrown);
		}

		.button:hover {
			border-width: 1px;
			padding: 14.5px 30px;
			font-weight: bold;
			background: var(--neonColor);
		}

	.label {
		display: inline-block;
		background-color: var(--accentRed);
		color: var(--background);
		border-radius: 20px;
		padding: 0.25em 0.7em;
	}

	select {
		font-family: "Times New Roman", Times, serif;
		font-size: 1em;
		color: var(--accentBrown);
		background-color: transparent;
		border: 1px solid var(--accentGreen);
		border-radius: 6px;
		padding: 0.25em 0.5em;
	}

	.explorer {
		.params {
			padding: 15px 0px;
			/* border: solid 1px white; */
			/* background-color: gray; */
		}
	}

	body {
		padding: 10px;
		width: 100%;
		height: 100%;
		margin: 0 auto;
		background-color: var(--background);
		/* `clip`, not `hidden`: `overflow-x: hidden` makes `overflow-y` compute to
		   `auto`, turning <body> into a scroll container — that reparents any
		   `position: sticky` descendant (the .config bar on the explorer page) to
		   <body> instead of the viewport, so it never sticks. `clip` hides the
		   full-bleed overflow the same way without the scroll-container side effect. */
		overflow-x: clip;
	}

	#canvas {
		display: block;
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: -1;
	}

	.header {
		width: 100%;
		padding: .1rem 0 .2rem .2rem;
		/* margin: 1rem 3rem; */
		position: fixed;
		top: 0px;
		left: 0px;
		a {
			color: #f7f7f7;
			margin: 2vw;
			font-size: .65em;
		}
		background-color: var(--charcoal);
	}

</style>


<script>
	const canvas = document.getElementById("canvas") as HTMLCanvasElement;
	const ctx = canvas.getContext("2d")!;
	// set canvas dims to match viewp size
	canvas.width = window.innerWidth;
	canvas.height = window.innerHeight;

	window.addEventListener("resize", () => {
		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;
	});

</script>
