---
import { colors } from "../styles/colors";

const { style } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png+xml" href="/RESL_Circular_logo.png" />
		<link rel="icon" href="/RESL_Circular_logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Networks in Environmental Lobbying</title>
	</head>
	<body style={style}>
		<canvas id="canvas"></canvas>
		<slot />
	</body>

</html>

<style is:global define:vars={colors}>
	html {
		margin: 3vh 8vw;
		h1 {
			font-size: 3em;
			color: var(--accentBrown);

			@media (max-width: 600px) {
				font-size: 2em;
			}
		}

		p {
			line-height: 1.5;
			@media (max-width: 600px) {
				font-size: .9em;
			}
		}

		a {
			color: rgb(117, 199, 2);
			font-weight: 700;
			text-decoration: none;
			transition-duration: 0.5s;
		}

		a:hover {
			color: rgb(148, 235, 43);
			
		}

		.hero {
			@media (max-width: 1000px) {
				width: 80vw;
			}
		}
	}

	.hero {
		position: relative;
		/* Without this, a positioned descendant with z-index:-1 (the hero-network svg)
		   doesn't stack "behind this element's other children" — position:relative alone
		   doesn't create a stacking context, so the negative z-index falls through to the
		   document root and lands behind unrelated ancestors, breaking hit-testing (drag). */
		isolation: isolate;
		height: 50vh;
		width: 60vw;
		display: flex;
		/* align-items: center; */
		justify-content: top;
		flex-direction: column;
		margin: 7.5vh 40px;


		.content {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 2em;
		}

		.hero-network {
			/* Flex footprint stays the same so surrounding text/layout don't shift; the
			   rendered svg itself escapes this box (see below) to appear as a large,
			   dimmed background behind the whole hero. */
			flex: 0 0 20%;
			width: 30vw;
			height: 50%;
			position: relative;
			overflow: visible;
			z-index: -1;
			pointer-events: none;

			svg {
				/* d3 sets width/height as inline styles on the svg element, which beat any
				   non-!important rule here regardless of selector specificity. */
				position: absolute !important;
				/* Re-enable hit-testing so node drag still works; the container above stays
				   pointer-events: none so the rest of the (mostly transparent) box doesn't
				   block clicks on the text/buttons layered in front of it. */
				pointer-events: auto;
				top: 50%;
				left: 50%;
				width: 65vw !important;
				height: auto !important;
				transform: translate(-50%, -50%);
				opacity: 0.35;
			}
		}

		.button {
			border: var(--nodeStroke) solid 0.5px;
			margin: 5% 5% 0px 0px;
			padding: 15px 32px;
			text-align: center;
			text-decoration: none;
			display: inline-block;
			font-size: 16px;
			cursor: pointer;
			color: var(--accentBrown);
		}

		.button:hover {
			border-width: 1px;
			padding: 14.5px 30px;
			font-weight: bold;
			background: var(--neonColor);
		}
	}

	.explorer {
		.params {
			padding: 10px;
			border: solid 1px white;
			/* background-color: gray; */
		}
	}

	body {
		padding: 10px;
		width: 100%;
		height: 100%;
		margin: 0 auto;
		background-color: var(--background);
		overflow-x: hidden;
	}

	#canvas {
		display: block;
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: -1;
	}

	.header {
		width: 100%;
		padding: .5rem 0 .5rem .5rem;
		/* margin: 1rem 3rem; */
		position: fixed;
		top: 0px;
		a {
			color: #101208;
			margin: 3vw;
		}
		background-color: #d8fc76;
	}

	/* @media (max-width: 600px) {
		.hero {
			padding: 5% 8%;
			height: auto;
			min-height: 100vh;
		}

		.content {
			flex-direction: column-reverse;
		}

		.hero-network {
			flex: 0 0 auto;
			width: 160px;
		}
	} */
</style>

<script>
	const canvas = document.getElementById("canvas") as HTMLCanvasElement;
	const ctx = canvas.getContext("2d")!;
	// set canvas dims to match viewp size
	canvas.width = window.innerWidth;
	canvas.height = window.innerHeight;

	window.addEventListener("resize", () => {
		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;
	});

	const circles = [];
	const maxCircles = 100;
	const trailLength = 20;


	function createCircle(x, y, radius, color) {
		circles.push({x,y,radius,color});
		if (circles.length > maxCircles) {
			circles.shift();
		}
	}

	function draw() {
		ctx.clearRect(0,0,canvas.width, canvas.height);

		for (let i = 0; i < circles.length; i++) {
			const circle = circles[i];

			ctx.beginPath();
			ctx.arc(circle.x, circle.y, circle.radius, 0, Math.PI * 2);
			ctx.fillStyle = circle.color;
			ctx.globalAlpha = (i / circles.length) * 0.5;
			ctx.fill();

			circle.radius += 1;
			if (circle.radius > 50) {
				circles.splice(i, 1);
				i--;
			}
		}
		requestAnimationFrame(draw);
	}

	function onMouseMove(event) {
		const x = event.clientX;
		const y = event.clientY;
		createCircle(x, y, 0, "#d8fc76");

	}

	window.addEventListener("mousemove", onMouseMove);

	draw();
</script>
