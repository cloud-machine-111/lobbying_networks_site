---
import { colors } from "../styles/colors";
---

<style is:global define:vars={colors}>

		h1 {
			font-size: 3em;
			color: var(--accentBrown);

			@media (max-width: 600px) {
				font-size: 2em;
			}
		}

		p {
			line-height: 1.5;
			@media (max-width: 600px) {
				font-size: .9em;
			}
		}

		a {
			color: rgb(117, 199, 2);
			font-weight: 700;
			text-decoration: none;
			transition-duration: 0.5s;
		}

		a:hover {
			color: rgb(148, 235, 43);

		}
</style>
